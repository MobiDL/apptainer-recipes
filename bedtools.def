Bootstrap: docker
From: ubuntu:22.04

%post
    apt-get update -y && apt-get install -y \
    make git tar g++ zlib1g-dev libbz2-dev liblzma-dev python3

    git clone --depth=1 --branch v2.31.1 https://github.com/arq5x/bedtools2
    cd bedtools2
    make
    mv bin/* /usr/local/bin/
    cd ../
    rm -rf bedtools2

%environment
    export PATH=/usr/local/bin:$PATH

%runscript
    exec bedtools "$@"