Bootstrap: docker
From: ubuntu:22.04

%post
    apt-get update -y && apt-get install -y \
        g++ \
        make \
        zlib1g-dev \
        git
    git clone --branch v0.7.19 https://github.com/lh3/bwa
    cd bwa
    make
    mv bwa /usr/local/bin
    cd ..
    rm -rf bwa

%environment
    export PATH=/usr/local/bin:$PATH

%runscript
    exec bwa "$@"