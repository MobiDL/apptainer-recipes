Bootstrap: docker
From: ubuntu:22.04

%post
    apt-get update -y && apt-get install -y \
        g++ \
        make \
        wget \
        curl \
        openssl \
        bzip2 \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
        libcurl4-openssl-dev \
        libncurses-dev \
        libssl-dev \
        tar \
        git

    wget https://github.com/samtools/samtools/releases/download/1.23.1/samtools-1.23.1.tar.bz2
    tar -xjf samtools-1.23.1.tar.bz2
    cd samtools-1.23.1
    ./configure --prefix=/usr/local/
    make
    make install
    cd ..
    rm -rf samtools-1.23.1 samtools-1.23.1.tar.bz2

%environment
    export PATH=/usr/local/bin:$PATH

%runscript
    exec samtools "$@"