Bootstrap: docker
From: ubuntu:22.04

%post
    apt-get update -y && apt-get install -y \
        g++ \
        make \
        wget \
        curl \
        openssl \
        bzip2 \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
        libcurl4-openssl-dev \
        libncurses-dev \
        libssl-dev \
        tar \
        gcc make autoconf automake pkg-config zlib1g-dev curl libgsl-dev  perl perl-doc libperl-dev libjson-perl \
        autoconf \
        git
    git clone --recurse-submodules https://github.com/samtools/htslib.git
    git clone --depth=1 --branch 1.23.1 https://github.com/samtools/bcftools
    cd bcftools/
    autoheader && autoconf && ./configure --enable-libgsl --enable-perl-filters
    make
    mv bcftools /usr/local/bin
    mv plugins /usr/local/lib/
    cd ..
    rm -rf bcftools

%environment
    export PATH=/usr/local/bin:$PATH
    export BCFTOOLS_PLUGINS=/usr/local/lib/plugins

%runscript
    exec bcftools "$@"
