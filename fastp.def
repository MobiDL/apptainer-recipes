Bootstrap: docker
From: ubuntu:22.04

%post
    apt-get update -y && apt-get install -y \
        wget \
        g++ \
        make \
        cmake \
        libisal-dev \
        libdeflate-dev \
        zlib1g-dev \
        libbz2-dev \
        git
    git clone --depth=1 --branch 1.3.0 https://github.com/google/highway.git
    cd highway
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DHWY_ENABLE_TESTS=OFF -DHWY_ENABLE_EXAMPLES=OFF
    cmake --build build
    cmake --install build
    cd ..     
    rm -rf highway
    git clone --depth 1 --branch v1.3.6 https://github.com/OpenGene/fastp
    cd fastp
    make -j
    make install
    cd ..
    rm -rf fastp

%environment
    export PATH=/usr/local/bin:$PATH

%runscript
    exec fastp "$@"